PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# ===== JWT =====
# Bắt buộc: hai secret khác nhau, tạo bằng `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Không bắt buộc: mặc định dùng chung JWT_ACCESS_SECRET
JWT_VERIFY_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_VERIFY_EXPIRES_IN=10m

# ===== Xác minh email =====
VERIFICATION_CODE_TTL_MINUTES=10
BCRYPT_ROUNDS=10
# Chưa điền SMTP thì server in mã xác minh ra console (chỉ ở môi trường dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ===== Rate limit (chống spam/brute force) =====
# Số request tối đa cho mỗi IP trong 1 cửa sổ thời gian; đặt 0 để tắt.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
