PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# ===== JWT =====
# Bắt buộc: hai secret khác nhau, tạo bằng `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Không bắt buộc: mặc định dùng chung JWT_ACCESS_SECRET
JWT_VERIFY_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_VERIFY_EXPIRES_IN=10m
# Token đặt lại mật khẩu; không bắt buộc, mặc định dùng chung JWT_ACCESS_SECRET.
JWT_RESET_SECRET=
JWT_RESET_EXPIRES_IN=10m

# ===== Xác minh email / quên mật khẩu =====
VERIFICATION_CODE_TTL_MINUTES=10
PASSWORD_RESET_CODE_TTL_MINUTES=10
BCRYPT_ROUNDS=10
# Chưa điền SMTP thì server in mã xác minh ra console (chỉ ở môi trường dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ===== Rate limit (chống spam/brute force) =====
# Số request tối đa cho mỗi IP trong 1 cửa sổ thời gian; đặt 0 để tắt.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20

# ===== Thông báo đẩy (Expo Push) =====
# URL dịch vụ Expo Push; thường không cần đổi.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Chỉ điền khi bật Push Security trong Expo (tùy chọn).
EXPO_ACCESS_TOKEN=
# Cron quét thực phẩm sắp hết hạn: mặc định 08:00 mỗi ngày, giờ Việt Nam.
EXPIRY_CRON_SCHEDULE="0 8 * * *"
EXPIRY_CRON_TIMEZONE=Asia/Ho_Chi_Minh
# Nhắc trước bao nhiêu ngày (mặc định 3, đúng yêu cầu đề bài).
EXPIRY_NOTIFY_DAYS=3

# ===== Cloudinary (lưu ảnh đại diện & ảnh thực phẩm) =====
# Lấy trong Cloudinary Dashboard > Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Thư mục gốc chứa ảnh; mỗi loại ảnh nằm trong thư mục con (avatars, foods).
CLOUDINARY_FOLDER=di-cho-tien-loi

# ===== Tạo tài khoản admin (npm run seed:admin) =====
# Bắt buộc: email và mật khẩu 6–20 ký tự. Tài khoản đã tồn tại sẽ được nâng quyền
# và đặt lại mật khẩu theo giá trị dưới đây.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị viên
# Không bắt buộc; tài khoản mới mặc định dùng "admin".
ADMIN_USERNAME=admin
